<!DOCTYPE html>
<html lang="ro">
    <head>
        <meta name="description" content="Ceainaria Camellie ofera sortimente de ceiauri, cu posibilitatea de a achizitiona online si livrare prin curier.">
        <meta name="keywords" content="ceai, ceaiuri, ceainarie, Camellie, ceai verde, ceai negru, ceainic, produse">
        <title>Camellie's Corner - Produse</title>
        <%- include("../fragments/header") %>     
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <script type="text/javascript" src="/resurse/js/bootstrap_js.js"></script>

        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    </head>
    <body>

    <%- include("../fragments/head") %>

    <main class="container py-4">

        <!-- Sectiune de filtre -->
        <div class="row g-3 mb-4">

            <!-- Nume -->
            <div class="col-sm-6 col-lg-4">
                <label for="inp-nume" class="form-label fw-semibold">Nume produs</label>
                <input type="text" id="inp-nume" class="form-control" list="datalist-nume" placeholder="Caută după nume...">
                <datalist id="datalist-nume">
                    <% for (let p of locals.produse) { %>
                        <option value="<%- p.nume %>"></option>
                    <% } %>
                </datalist>
            </div>

            <!-- Categorie -->
            <div class="col-sm-6 col-lg-4">
                <label for="inp-categorie" class="form-label fw-semibold">Categorie</label>
                <select id="inp-categorie" class="form-select">
                    <option id="sel-toate" selected value="toate">Toate</option>
                    <% for (let opt of locals.optiuni) { %>
                        <option value="<%- opt.unnest %>"><%- opt.unnest %></option>
                    <% } %>
                </select>
            </div>

            <!-- Preț minim (range) -->
            <div class="col-sm-12 col-lg-4">
                <label for="inp-pret" class="form-label fw-semibold">
                    Preț minim:
                    <span id="pret-min"><%- typeof pretMin !== 'undefined' ? pretMin : 0 %></span> –
                    <span id="pret-max"><%- typeof pretMax !== 'undefined' ? pretMax : 0 %></span> lei
                    <span id="infoRange" class="text-primary fw-bold">(<%- typeof pretMin !== 'undefined' ? pretMin : 0 %>)</span>
                </label>
                <input type="range" class="form-range" id="inp-pret" value="<%- typeof pretMin !== 'undefined' ? pretMin : 0 %>" min="<%- typeof pretMin !== 'undefined' ? pretMin : 0 %>" max="<%- typeof pretMax !== 'undefined' ? pretMax : 0 %>">
            </div>

            <!-- Gramaj — radio toggle buttons -->
            <div class="col-12">
                <p class="form-label fw-semibold mb-2">Gramaj</p>
                <div class="btn-group flex-wrap" role="group" aria-label="Filtrare gramaj">
                    <input type="radio" class="btn-check" id="i_rad1" name="gr_rad" value="0:100" autocomplete="off">
                    <label class="btn btn-outline-primary" for="i_rad1">Mic (&lt;100g)</label>

                    <input type="radio" class="btn-check" id="i_rad2" name="gr_rad" value="100:200" autocomplete="off">
                    <label class="btn btn-outline-primary" for="i_rad2">Mediu (100–200g)</label>

                    <input type="radio" class="btn-check" id="i_rad3" name="gr_rad" value="200:1000000000" autocomplete="off">
                    <label class="btn btn-outline-primary" for="i_rad3">Mare (&ge;200g)</label>

                    <input type="radio" class="btn-check" id="i_rad4" checked name="gr_rad" value="toate" autocomplete="off">
                    <label class="btn btn-outline-primary" for="i_rad4">Toate</label>
                </div>
            </div>

            <!-- Cuvinte cheie — floating label textarea -->
            <div class="col-sm-6">
                <div class="form-floating">
                    <textarea class="form-control" id="inp-keywords"
                        placeholder="ex: portocala, ghimbir"
                        style="height: 90px"></textarea>
                    <label for="inp-keywords">Cuvinte cheie în descriere (separate cu virgulă)</label>
                </div>
            </div>

            <!-- Tip produs — toggle buttons generate dinamic de JS -->
            <div class="col-sm-6">
                <p class="form-label fw-semibold mb-2">Tip produs</p>
                <!-- JS va popula acest div cu btn-check-uri -->
                <div id="inp-tip-multiplu" class="d-flex flex-wrap gap-2">
                </div>
            </div>

            <!-- Ingrediente — toggle buttons generate dinamic de JS -->
            <div class="col-12">
                <p class="form-label fw-semibold mb-2">Ingrediente (alege unul sau mai multe)</p>
                <!-- JS va popula acest div cu btn-check-uri -->
                <div id="checkbox-ingrediente" class="d-flex flex-wrap gap-2">
                </div>
            </div>

        </div><!-- /.row (filtre) -->

        <!-- ===== BUTOANE ACȚIUNE =====  -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            <button class="btn btn-primary" id="filtrare">
                <span class="d-none d-md-inline">Filtrează</span>
                <i class="bi bi-filter"></i>
            </button>
            <button class="btn btn-outline-secondary" id="resetare">
                <span class="d-none d-md-inline">Resetează</span>
                <i class="bi bi-arrow-clockwise"></i> 
            </button>
            <button class="btn btn-outline-primary" id="sortCrescNume">
                <span class="d-none d-md-inline">Preț / Nume</span>
                <i class="bi bi-arrow-up"></i>
            </button>
            <button class="btn btn-outline-primary" id="sortDescrescNume">
                <span class="d-none d-md-inline">Preț / Nume</span>
                <i class="bi bi-arrow-down"></i>
            </button>
        </div>

        <p id="p-suma" class="text-muted fst-italic">
            Apăsați <kbd>Alt</kbd>+<kbd>C</kbd> pentru suma prețurilor produselor afișate.
        </p>

        <!-- ===== SECȚIUNEA PRODUSE ===== -->
        <section id="produse">
            <h2>Produse</h2>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                <% for( let prod of locals.produse) { %>
                    <div class="col produs" style="opacity: 0; transform: translateY(10px); transition: opacity 300ms ease, transform 300ms ease;">
                        <article class="card h-100 card-produs" role="button" tabindex="0" aria-label="Deschide detalii produs în fereastră modală">
                            <a href="/produs/<%-prod.id %>">
                                <img src="/resurse/imagini/produse/<%- prod.imagine %>" class="card-img-top img-fluid" alt="imagine <%- prod.nume %>">
                            </a>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title mb-1">
                                    <a href="/produs/<%-prod.id %>" class="stretched-link text-decoration-none text-dark"><span class="val-nume"><%- prod.nume%></span></a>
                                </h5>
                                <p class="card-text text-muted small mb-2"><span class="val-descriere"><%- prod.descriere%></span></p>
                                <p class="mb-2"><strong>Preț:</strong> <span class="val-pret"><%- prod.pret%></span> lei</p>
                                <p class="text-muted mb-2">Categorie: <span class="val-categorie"><%- prod.categorie%></span></p>
                                <p style="display:none" class="val-ingrediente"><%- prod.ingrediente ? prod.ingrediente.join(',') : '' %></p>
                                <p style="display:none" class="val-tip"><%- prod.tip_produs %></p>
                                <p style="display:none" class="val-cafeina"><%- prod.cafeina ? 'Da' : 'Nu' %></p>
                                <p style="display:none" class="val-data-adaugare"><%- prod.data_adaugare.toLocaleDateString('ro-RO') %></p>
                                <% if (prod.gramaj) { %>
                                    <p class="mb-2">Gramaj: <span class="val-gramaj"><%- prod.gramaj%></span></p>
                                <% } %>

                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <label class="selecteaza-cos mb-0">
                                        <input type="checkbox" class="select-cos" value="<%-prod.id %>" autocomplete="off"> Adaugă
                                    </label>
                                    <a href="/produs/<%-prod.id %>" class="btn btn-sm btn-outline-primary">Detalii</a>
                                </div>
                            </div>
                        </article>
                    </div>
                <% } %>
            </div>
        </section>
        <!-- BONUS 11 ETAPA 6 MODAL -->
        <div class="modal fade" id="modal-produs" tabindex="-1" aria-labelledby="modal-produs-titlu" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-produs-titlu">Detalii produs</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Închide"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-5 text-center">
                                <img id="modal-produs-imagine" src="" alt="Imagine produs" class="img-fluid rounded">
                            </div>
                            <div class="col-md-7">
                                <p class="mb-2"><strong>Preț:</strong> <span id="modal-produs-pret">-</span> lei</p>
                                <p class="mb-2"><strong>Descriere:</strong> <span id="modal-produs-descriere">-</span></p>
                                <p class="mb-2"><strong>Ingrediente:</strong> <span id="modal-produs-ingrediente">-</span></p>
                                <p class="mb-2"><strong>Gramaj:</strong> <span id="modal-produs-gramaj">-</span></p>
                                <p class="mb-2"><strong>Categorie:</strong> <span id="modal-produs-categorie">-</span></p>
                                <p class="mb-2"><strong>Tip produs:</strong> <span id="modal-produs-tip">-</span></p>
                                <p class="mb-2"><strong>Cafeină:</strong> <span id="modal-produs-cafeina">-</span></p>
                                <p class="mb-0"><strong>Data adăugare:</strong> <span id="modal-produs-data">-</span></p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                        <a id="modal-btn-pagina-produs" href="#" class="btn btn-primary">Pagina produsului</a>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <%- include("../fragments/footer") %>
    </body>
</html>
