<!DOCTYPE html>
<html lang="ro">
    <head>
        <meta name="description" content="Cofetaria Dulcelind ofera prajituri, torturi, produse de patiserie cu optiunea de achizitie online si livrare prin curier.">
        <meta name="keywords" content="cofetarie, Dulcelind, prajituri, torturi, dulce, pateuri, produse">
        <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
        <title>Camellie's Corner - Produse</title>
        <%- include("../fragments/header") %>     
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <!-- <script type="text/javascript" src=/resurse/js/produse-cos.js></script> -->

    </head>
    <body>


    <%- include("../fragments/head") %>

    <main>
        <label> Nume: <input type="text" id="inp-nume" list="datalist-nume"></label>
        <datalist id="datalist-nume">
            <% for (let p of locals.produse) { %>
                <option value="<%- p.nume %>"></option>
            <% } %>
        </datalist>
        <!--<label> Maxim calorii: <input type="number" id="inp-calorii" value="10000"></label>-->
        <div> Gramaj:<!-- trebuie sa aiba acelasi name ca sa formeze un grup -->
            <p><label>Mic (gramaj &lt; 100)
                <input id="i_rad1"  name="gr_rad" value="0:100" type="radio"/>
            </label></p>
            <p><label>Mediu (100 &le; gramaj &lt; 200)
                <input id="i_rad2"  name="gr_rad" value="100:200" type="radio"/>
            </label>
            <p><label> Mare (gramaj &ge; 200)
                <input id="i_rad3" name="gr_rad" value="200:1000000000" type="radio"/>
            </label>
            <p><label>Toate
                <input id="i_rad4" checked name="gr_rad" value="toate" type="radio"/>
            </label>
        </div>


        <label> Pret minim:
            <span id="pret-min">0</span>
            <input type="range" id="inp-pret" value="0" min="0"  max="70">
            <span id="pret-max">70</span>
            <span id="infoRange">(0)</span>
        </label>

        <label> Cuvinte cheie (în descriere, separate cu virgulă):<br/>
            <textarea id="inp-keywords" rows="2" cols="40" placeholder="ex: portocala, ghimbir"></textarea>
        </label>

        <label> Ingrediente (alege 1+):
            <div id="checkbox-ingrediente">
                <!-- checkbox-uri populate dinamic -->
            </div>
        </label>

        <label> Tip produs (select multiplu):
            <select id="inp-tip-multiplu" multiple size="4">
                <!-- optiuni populate dinamic -->
            </select>
        </label>
        <label>Select simplu:
            <select id="inp-categorie">
                <option id="sel-toate" selected value="toate">toate</option>
                <% for (let opt of locals.optiuni) { %>
                    <option value="<%- opt.unnest %>"><%- opt.unnest %> </option>
                <% } %>
            </select>
        </label>

        <p>
        <button class="c1 c2 c3" id="filtrare">Filtreaza</button> 

        <button id="resetare">Reseteaza</button><br/>
        <button id="sortCrescNume">Sorteaza crescator dupa pret si nume</button>
        <button id="sortDescrescNume">Sorteaza descrescator dupa pret si nume</button>
        
        </p>
      
        <p id="p-suma">Apăsați Alt+"c" pentru suma preturilor produselor afișate. </p>
  
        <section id="produse">

            <h2>Produse</h2>
            <div class="grid-produse">
                <% for( let prod of locals.produse) { %>
                    <article class="produs" >
                        <h3 class="nume">Nume: <a href="/produs/<%-prod.id %>" ><span class="val-nume"><%- prod.nume%></span></a></h3>
                        <div class="info-prod">
                            <p class="pret">Pret: <span class="val-pret"><%- prod.pret%></span></p>
                            <p class="descriere">Descriere: <span class="val-descriere"><%- prod.descriere%></span></p>
                            <p style="display:none" class="val-ingrediente"><%- prod.ingrediente ? prod.ingrediente.join(',') : '' %></p>
                            <p style="display:none" class="val-tip"><%- prod.tip_produs %></p>
                            <% if (prod.gramaj) { %>
                                <p class="gramaj">Gramaj: <span class="val-gramaj"><%- prod.gramaj%></span></p>
                            <% } %>
                        </div>
                        <p class="categorie">Categorie:<span class="val-categorie"><%- prod.categorie%></span></p>
                        <figure>
                            <a href="/produs/<%-prod.id %>" ><img src="/resurse/imagini/produse/<%- prod.imagine %>" style="width:50%;height:auto;" alt="[imagine <%- prod.nume %>]" /></a>
                        </figure>
                        <label class="selecteaza-cos">
                            Selectează:<br/>
                            <input type="checkbox" class="select-cos" value="<%-prod.id %>" autocomplete="off">
                        </label>
                    </article>
                <% }%>
            </div>
        </section>
    </main>

    <%- include("../fragments/footer") %>
    </body>
</html>