<!DOCTYPE html>
<html lang="ro">
    <head>
        <meta name="description" content="Ceainaria Camellie ofera sortimente de ceiauri, cu posibilitatea de a achizitiona online si livrare prin curier.">
        <meta name="keywords" content="ceai, ceaiuri, ceainarie, Camellie, ceai verde, ceai negru, ceainic, produse<%- locals.prod.nume %>">
        
        <title>Camille's Corner - <%- locals.prod.nume %></title>
        <%- include("../fragments/header") %>     
        <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
    </head>

        <%- include("../fragments/head") %>
    <main>
        <section>
            <h2>Pagină produs</h2>
                <article id="art-produs">
                    <h3><span class="nume"><%- locals.prod.nume %></span></h3>
                    <p>Pret: <span class="pret"><%- locals.prod.pret %> </span></p>
                    <p>Descriere: <span class="descriere"><%- locals.prod.descriere %> </span></p>
                    <p>Ingrediente: <span class="ingrediente"><%- locals.prod.ingrediente %> </span></p>
                    <p>Gramaj: <span class="gramaj"><%- locals.prod.gramaj %> </span></p>
                    <p>Categorie: <span class="categorie"><%- locals.prod.categorie %> </span></p>
                    <p>Cafeina: <span class="cafeina">
                        <%- locals.prod.cafeina ? "Da" : "Nu" %> 
                    </span></p>
                    <p>Data adăugare: <span class="categorie"><%- locals.prod.data_adaugare.toLocaleDateString('ro-RO') %> </span></p>
                    <figure class="imag-produs">
                        <img  src="/resurse/imagini/galerie/<%- locals.prod.imagine %>" alt="[imagine <%- locals.prod.nume %>]" />
                    </figure>
                </article>
            
        </section>
    </main>

    <%- include("../fragments/footer") %>
    <script src="/resurse/js/cookies.js"></script>
    <script>
        setCookie("ultimulProdusClic", "<%= locals.prod.id %>", 86400000);
    </script>
    </body>
</html>